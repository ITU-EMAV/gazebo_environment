<?xml version="1.0"?>
<!-- GNSS receiver (navsat) on a fixed link. Needs the NavSat system in the world and
     <spherical_coordinates> in the world for real latitude/longitude. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Error of a standalone (non-RTK) GNSS receiver. Gazebo adds the horizontal noise to
         latitude and longitude in degrees, so it is converted from metres here. -->
    <xacro:property name="gnss_horizontal_noise" value="1.0" />   <!-- [m] -->
    <xacro:property name="gnss_vertical_noise" value="1.5" />     <!-- [m] -->
    <xacro:property name="gnss_velocity_noise" value="0.05" />    <!-- [m/s] -->
    <xacro:property name="metres_per_degree" value="111320.0" />

    <xacro:macro name="gnss_noise" params="stddev">
        <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>${stddev}</stddev>
        </noise>
    </xacro:macro>

    <xacro:macro name="navsat" params="name parent_link *origin namespace update_rate:=10">
        <xacro:property name="base_frame" value="${name}_frame" />

        <joint name="${name}_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="${base_frame}" />
            <xacro:insert_block name="origin" />
        </joint>

        <link name="${base_frame}">
            <xacro:inertial_dummy />
        </link>

        <gazebo reference="${base_frame}">
            <sensor name="navsat_sensor" type="navsat">
                <always_on>1</always_on>
                <update_rate>${update_rate}</update_rate>
                <topic>${namespace}/sensors/${name}/navsat</topic>
                <gz_frame_id>${base_frame}</gz_frame_id>
                <navsat>
                    <position_sensing>
                        <horizontal>
                            <xacro:gnss_noise stddev="${gnss_horizontal_noise / metres_per_degree}" />
                        </horizontal>
                        <vertical>
                            <xacro:gnss_noise stddev="${gnss_vertical_noise}" />
                        </vertical>
                    </position_sensing>
                    <velocity_sensing>
                        <horizontal>
                            <xacro:gnss_noise stddev="${gnss_velocity_noise}" />
                        </horizontal>
                        <vertical>
                            <xacro:gnss_noise stddev="${gnss_velocity_noise}" />
                        </vertical>
                    </velocity_sensing>
                </navsat>
            </sensor>
        </gazebo>

        <gazebo reference="${name}_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>
    </xacro:macro>
</robot>
