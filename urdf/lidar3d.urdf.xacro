<?xml version="1.0"?>
<!--
  Velodyne VLP-16 (GPU ray casting) on a fixed link, publishing a point cloud.
  The link origin is the sensor's optical centre, 37.7 mm above its base.
  Needs the Sensors system in the world.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- VLP-16 datasheet: 16 channels over +-15 deg, 0.2 deg steps at 10 Hz, 100 m, +-3 cm -->
    <xacro:property name="lidar_horizontal_samples" value="1800" />
    <xacro:property name="lidar_vertical_samples" value="16" />
    <xacro:property name="lidar_vertical_half_angle" value="${15 * pi / 180}" />
    <xacro:property name="lidar_min_range" value="0.5" />
    <xacro:property name="lidar_max_range" value="100.0" />
    <xacro:property name="lidar_noise" value="0.015" />

    <xacro:macro name="lidar3d" params="name parent_link *origin namespace update_rate:=10">
        <xacro:property name="base_frame" value="${name}_lidar_frame" />

        <joint name="${name}_lidar_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="${base_frame}" />
            <xacro:insert_block name="origin" />
        </joint>

        <link name="${base_frame}">
            <xacro:inertial_dummy />
            <visual>
                <!-- The mesh is Y-up, in millimetres, with its origin at the base -->
                <origin xyz="0 0 -0.0377" rpy="${pi/2} 0 ${pi}" />
                <geometry>
                    <mesh filename="package://gazebo_environment/meshes/velodyne-vlp16.stl" scale="0.001 0.001 0.001" />
                </geometry>
            </visual>
        </link>

        <gazebo reference="${base_frame}">
            <sensor name="${name}_lidar_sensor" type="gpu_lidar">
                <always_on>true</always_on>
                <update_rate>${update_rate}</update_rate>
                <gz_frame_id>${base_frame}</gz_frame_id>
                <topic>${namespace}/sensors/${name}</topic>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>${lidar_horizontal_samples}</samples>
                            <min_angle>${-pi}</min_angle>
                            <max_angle>${pi}</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>${lidar_vertical_samples}</samples>
                            <min_angle>${-lidar_vertical_half_angle}</min_angle>
                            <max_angle>${lidar_vertical_half_angle}</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>${lidar_min_range}</min>
                        <max>${lidar_max_range}</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>${lidar_noise}</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>

        <gazebo reference="${name}_lidar_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>
    </xacro:macro>
</robot>
