<?xml version="1.0"?>
<!--
  Simulated sensors for the frames of sac_description (urdf/sensors.urdf.xacro): each macro
  adds a Gazebo sensor to a frame the description already has and publishes on
  <namespace>/sensors/<name>/... The world must load the Sensors, Imu and NavSat systems.
  Datasheet values are properties at the top of each part.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Keep a fixed joint's child as its own link, so a sensor on it reports in that frame
         instead of being merged into the parent -->
    <xacro:macro name="preserve_joint" params="joint">
        <gazebo reference="${joint}">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="gaussian_noise" params="stddev">
        <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>${stddev}</stddev>
        </noise>
    </xacro:macro>

    <!-- ============================== IMU ============================== -->
    <!-- Noise of a MEMS IMU like the ZED 2's (Bosch BMI085) at 100 Hz: white noise from the
         noise densities (0.014 deg/s/sqrt(Hz), 175 ug/sqrt(Hz)) over a 50 Hz bandwidth, and a
         constant bias drawn once per run -->
    <xacro:property name="imu_gyro_noise" value="0.0017" />         <!-- [rad/s] -->
    <xacro:property name="imu_gyro_bias" value="0.0005" />          <!-- [rad/s] -->
    <xacro:property name="imu_accel_noise" value="0.012" />         <!-- [m/s^2] -->
    <xacro:property name="imu_accel_bias" value="0.02" />           <!-- [m/s^2] -->

    <xacro:macro name="imu_axis_noise" params="axis stddev bias">
        <xacro:element xacro:name="${axis}">
            <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>${stddev}</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>${bias}</bias_stddev>
            </noise>
        </xacro:element>
    </xacro:macro>

    <!-- On the frame of sac_description's imu macro: <name>_frame unless given -->
    <xacro:macro name="imu_gazebo" params="name namespace update_rate:=100 frame:=''">
        <xacro:property name="base_frame" value="${frame if frame else name + '_frame'}" />

        <gazebo reference="${base_frame}">
            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>${update_rate}</update_rate>
                <topic>${namespace}/sensors/${name}/imu</topic>
                <gz_frame_id>${base_frame}</gz_frame_id>
                <imu>
                    <angular_velocity>
                        <xacro:imu_axis_noise axis="x" stddev="${imu_gyro_noise}" bias="${imu_gyro_bias}" />
                        <xacro:imu_axis_noise axis="y" stddev="${imu_gyro_noise}" bias="${imu_gyro_bias}" />
                        <xacro:imu_axis_noise axis="z" stddev="${imu_gyro_noise}" bias="${imu_gyro_bias}" />
                    </angular_velocity>
                    <linear_acceleration>
                        <xacro:imu_axis_noise axis="x" stddev="${imu_accel_noise}" bias="${imu_accel_bias}" />
                        <xacro:imu_axis_noise axis="y" stddev="${imu_accel_noise}" bias="${imu_accel_bias}" />
                        <xacro:imu_axis_noise axis="z" stddev="${imu_accel_noise}" bias="${imu_accel_bias}" />
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>
        <xacro:preserve_joint joint="${base_frame}_joint" />
    </xacro:macro>

    <!-- ============================== GNSS ============================== -->
    <!-- Error of a standalone (non-RTK) GNSS receiver like the real car's. Gazebo adds the
         horizontal noise to latitude and longitude in degrees, so it is converted from metres
         here. Needs <spherical_coordinates> in the world for real latitude/longitude. -->
    <xacro:property name="gnss_horizontal_noise" value="1.0" />   <!-- [m] -->
    <xacro:property name="gnss_vertical_noise" value="1.5" />     <!-- [m] -->
    <xacro:property name="gnss_velocity_noise" value="0.05" />    <!-- [m/s] -->
    <xacro:property name="metres_per_degree" value="111320.0" />

    <xacro:macro name="navsat_gazebo" params="name namespace update_rate:=10">
        <gazebo reference="${name}_frame">
            <sensor name="navsat_sensor" type="navsat">
                <always_on>1</always_on>
                <update_rate>${update_rate}</update_rate>
                <topic>${namespace}/sensors/${name}/navsat</topic>
                <gz_frame_id>${name}_frame</gz_frame_id>
                <navsat>
                    <position_sensing>
                        <horizontal>
                            <xacro:gaussian_noise stddev="${gnss_horizontal_noise / metres_per_degree}" />
                        </horizontal>
                        <vertical>
                            <xacro:gaussian_noise stddev="${gnss_vertical_noise}" />
                        </vertical>
                    </position_sensing>
                    <velocity_sensing>
                        <horizontal>
                            <xacro:gaussian_noise stddev="${gnss_velocity_noise}" />
                        </horizontal>
                        <vertical>
                            <xacro:gaussian_noise stddev="${gnss_velocity_noise}" />
                        </vertical>
                    </velocity_sensing>
                </navsat>
            </sensor>
        </gazebo>
        <xacro:preserve_joint joint="${name}_joint" />
    </xacro:macro>

    <!-- ============================== Velodyne VLP-16 ============================== -->
    <!-- Datasheet: 16 channels over +-15 deg, 0.2 deg steps at 10 Hz, 100 m, +-3 cm -->
    <xacro:property name="lidar_horizontal_samples" value="1800" />
    <xacro:property name="lidar_vertical_samples" value="16" />
    <xacro:property name="lidar_vertical_half_angle" value="${15 * pi / 180}" />
    <xacro:property name="lidar_min_range" value="0.5" />
    <xacro:property name="lidar_max_range" value="100.0" />
    <xacro:property name="lidar_noise" value="0.015" />

    <!-- GPU ray casting; publishes <namespace>/sensors/<name>/points (with the no-return rays
         as inf, see lidar_filter) -->
    <xacro:macro name="vlp16_gazebo" params="name namespace update_rate:=10">
        <gazebo reference="${name}_frame">
            <sensor name="${name}_sensor" type="gpu_lidar">
                <always_on>true</always_on>
                <update_rate>${update_rate}</update_rate>
                <gz_frame_id>${name}_frame</gz_frame_id>
                <topic>${namespace}/sensors/${name}</topic>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>${lidar_horizontal_samples}</samples>
                            <min_angle>${-pi}</min_angle>
                            <max_angle>${pi}</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>${lidar_vertical_samples}</samples>
                            <min_angle>${-lidar_vertical_half_angle}</min_angle>
                            <max_angle>${lidar_vertical_half_angle}</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>${lidar_min_range}</min>
                        <max>${lidar_max_range}</max>
                        <resolution>0.01</resolution>
                    </range>
                    <!-- The lidar's noise takes <type> as an element, not an attribute -->
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>${lidar_noise}</stddev>
                    </noise>
                </lidar>
            </sensor>
        </gazebo>
        <xacro:preserve_joint joint="${name}_joint" />
    </xacro:macro>

    <!-- ============================== Stereolabs ZED 2 ============================== -->
    <xacro:property name="zed2_horizontal_fov" value="${110 * pi / 180}" />
    <xacro:property name="zed2_min_depth" value="0.3" />
    <xacro:property name="zed2_max_depth" value="20.0" />
    <!-- Simulated stream: HD720 at 15 Hz, one of the camera's modes (it also does 30/60 Hz,
         1080p and 2K) -->
    <xacro:property name="zed2_width" value="1280" />
    <xacro:property name="zed2_height_px" value="720" />
    <xacro:property name="zed2_rate" value="15" />
    <!-- Sensor noise of the colour image, as a fraction of the pixel range -->
    <xacro:property name="zed2_image_noise" value="0.007" />

    <!-- An RGB-D camera at the left camera, like the wrapper's rectified left image and
         depth, and the camera's IMU -->
    <xacro:macro name="zed2_gazebo" params="name namespace">
        <gazebo reference="${name}_left_camera_frame">
            <sensor name="${name}_rgbd" type="rgbd_camera">
                <camera>
                    <horizontal_fov>${zed2_horizontal_fov}</horizontal_fov>
                    <image>
                        <width>${zed2_width}</width>
                        <height>${zed2_height_px}</height>
                    </image>
                    <!-- The colour image sees far away; depth stops at the camera's range -->
                    <clip>
                        <near>0.1</near>
                        <far>500</far>
                    </clip>
                    <depth_camera>
                        <clip>
                            <near>${zed2_min_depth}</near>
                            <far>${zed2_max_depth}</far>
                        </clip>
                    </depth_camera>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>${zed2_image_noise}</stddev>
                    </noise>
                    <optical_frame_id>${name}_left_camera_optical_frame</optical_frame_id>
                </camera>
                <always_on>1</always_on>
                <update_rate>${zed2_rate}</update_rate>
                <topic>${namespace}/sensors/${name}</topic>
            </sensor>
        </gazebo>

        <xacro:imu_gazebo name="${name}" frame="${name}_imu_link" namespace="${namespace}" />

        <xacro:preserve_joint joint="${name}_camera_joint" />
        <xacro:preserve_joint joint="${name}_camera_center_joint" />
        <xacro:preserve_joint joint="${name}_left_camera_joint" />
        <xacro:preserve_joint joint="${name}_left_camera_optical_joint" />
        <xacro:preserve_joint joint="${name}_right_camera_joint" />
        <xacro:preserve_joint joint="${name}_right_camera_optical_joint" />
    </xacro:macro>
</robot>
