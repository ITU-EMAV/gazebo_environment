<?xml version="1.0"?>
<!-- IMU on a fixed link. Needs the Imu system in the world. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="imu" params="name parent_link *origin namespace update_rate:=100">
        <xacro:property name="base_frame" value="${name}_imu_frame" />

        <joint name="${name}_imu_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="${base_frame}" />
            <xacro:insert_block name="origin" />
        </joint>

        <link name="${base_frame}">
            <xacro:inertial_dummy />
        </link>

        <gazebo reference="${base_frame}">
            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>${update_rate}</update_rate>
                <topic>${namespace}/sensors/${name}/imu</topic>
                <gz_frame_id>${base_frame}</gz_frame_id>
            </sensor>
        </gazebo>

        <!-- Keep the frame as its own link in Gazebo so the sensor reports in it -->
        <gazebo reference="${name}_imu_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>
    </xacro:macro>
</robot>
