<?xml version="1.0"?>
<!--
  Stereolabs ZED 2 stereo camera with its IMU.

  Frame names follow the ZED ROS 2 wrapper (<name>_camera_link, _camera_center,
  _left/right_camera_frame and _optical_frame, _imu_link), so recorded data from the real
  camera and the simulation share one TF tree. The simulated sensor is an RGB-D camera at
  the left camera, like the wrapper's rectified left image and depth.
  Needs the Sensors and Imu systems in the world.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- ZED 2 datasheet -->
    <xacro:property name="zed2_baseline" value="0.12" />          <!-- [m] -->
    <xacro:property name="zed2_size" value="0.030 0.175 0.033" />  <!-- depth, width, height [m] -->
    <xacro:property name="zed2_height" value="0.033" />
    <xacro:property name="zed2_mass" value="0.166" />
    <xacro:property name="zed2_horizontal_fov" value="${110 * pi / 180}" />
    <xacro:property name="zed2_min_depth" value="0.3" />
    <xacro:property name="zed2_max_depth" value="20.0" />
    <!-- Simulated stream: HD720 at 30 Hz (the camera also does 1080p/2K) -->
    <xacro:property name="zed2_width" value="1280" />
    <xacro:property name="zed2_height_px" value="720" />
    <xacro:property name="zed2_rate" value="30" />

    <xacro:macro name="zed2" params="name parent_link *origin namespace">
        <!-- Rotation from a body frame (x forward) to an optical frame (z forward) -->
        <xacro:property name="optical_rpy" value="${-pi/2} 0 ${-pi/2}" />

        <!-- Mounting point: middle of the bottom face -->
        <joint name="${name}_camera_joint" type="fixed">
            <parent link="${parent_link}" />
            <child link="${name}_camera_link" />
            <xacro:insert_block name="origin" />
        </joint>
        <link name="${name}_camera_link">
            <xacro:inertial_dummy />
        </link>

        <joint name="${name}_camera_center_joint" type="fixed">
            <parent link="${name}_camera_link" />
            <child link="${name}_camera_center" />
            <origin xyz="0 0 ${zed2_height / 2}" rpy="0 0 0" />
        </joint>
        <link name="${name}_camera_center">
            <visual>
                <geometry>
                    <box size="${zed2_size}" />
                </geometry>
                <material name="zed_gray">
                    <color rgba="0.15 0.15 0.15 1" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="${zed2_size}" />
                </geometry>
            </collision>
            <xacro:inertial_cuboid mass="${zed2_mass}" x="0.030" y="0.175" z="0.033" />
        </link>

        <xacro:macro name="zed2_eye" params="side y">
            <joint name="${name}_${side}_camera_joint" type="fixed">
                <parent link="${name}_camera_center" />
                <child link="${name}_${side}_camera_frame" />
                <origin xyz="0 ${y} 0" rpy="0 0 0" />
            </joint>
            <link name="${name}_${side}_camera_frame">
                <xacro:inertial_dummy />
            </link>

            <joint name="${name}_${side}_camera_optical_joint" type="fixed">
                <parent link="${name}_${side}_camera_frame" />
                <child link="${name}_${side}_camera_optical_frame" />
                <origin xyz="0 0 0" rpy="${optical_rpy}" />
            </joint>
            <link name="${name}_${side}_camera_optical_frame">
                <xacro:inertial_dummy />
            </link>
        </xacro:macro>
        <xacro:zed2_eye side="left" y="${zed2_baseline / 2}" />
        <xacro:zed2_eye side="right" y="${-zed2_baseline / 2}" />

        <!-- IMU at the camera centre (the real offset comes from the camera's calibration) -->
        <xacro:imu name="${name}" frame="${name}_imu_link" parent_link="${name}_camera_center" namespace="${namespace}">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:imu>

        <gazebo reference="${name}_left_camera_frame">
            <sensor name="${name}_rgbd" type="rgbd_camera">
                <camera>
                    <horizontal_fov>${zed2_horizontal_fov}</horizontal_fov>
                    <image>
                        <width>${zed2_width}</width>
                        <height>${zed2_height_px}</height>
                    </image>
                    <!-- The colour image sees far away; depth stops at the camera's range -->
                    <clip>
                        <near>0.1</near>
                        <far>500</far>
                    </clip>
                    <depth_camera>
                        <clip>
                            <near>${zed2_min_depth}</near>
                            <far>${zed2_max_depth}</far>
                        </clip>
                    </depth_camera>
                    <optical_frame_id>${name}_left_camera_optical_frame</optical_frame_id>
                </camera>
                <always_on>1</always_on>
                <update_rate>${zed2_rate}</update_rate>
                <topic>${namespace}/sensors/${name}</topic>
            </sensor>
        </gazebo>

        <!-- Keep the frames as links in Gazebo instead of merging them into the parent -->
        <xacro:macro name="zed2_preserve" params="joint">
            <gazebo reference="${joint}">
                <preserveFixedJoint>true</preserveFixedJoint>
            </gazebo>
        </xacro:macro>
        <xacro:zed2_preserve joint="${name}_camera_joint" />
        <xacro:zed2_preserve joint="${name}_camera_center_joint" />
        <xacro:zed2_preserve joint="${name}_left_camera_joint" />
        <xacro:zed2_preserve joint="${name}_left_camera_optical_joint" />
        <xacro:zed2_preserve joint="${name}_right_camera_joint" />
        <xacro:zed2_preserve joint="${name}_right_camera_optical_joint" />

    </xacro:macro>
</robot>
