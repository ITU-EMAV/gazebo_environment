<?xml version="1.0"?>
<!--
  The SAC car in Gazebo Harmonic: sac_description's URDF (the same one the real car uses)
  plus the simulated sensors and the Gazebo systems that drive it. Dimensions, limits and
  sensor mounts are in sac_description; only what is simulation-specific lives here.

  Topics are under /<namespace>/ (default sac). The world must load the Sensors, Imu and
  NavSat systems (see worlds/sonoma.sdf).
-->
<robot name="$(arg namespace)" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="namespace" default="sac" />
  <xacro:property name="namespace" value="$(arg namespace)" />
  <!-- Springs and dampers on the wheels (sac_description's suspension); false: a rigid car -->
  <xacro:arg name="suspension" default="true" />

  <xacro:include filename="$(find sac_description)/urdf/sac.urdf.xacro" />
  <xacro:include filename="$(find gazebo_environment)/urdf/sensors.gazebo.xacro" />

  <!-- ============================== Suspension ============================== -->
  <!-- The damper is the joint's damping (sac_description); the spring is Gazebo's joint
       spring. Its natural length makes the corner load (the whole car's weight on that
       corner) compress it to the middle of the travel at rest, so the car and its sensors
       stand at the description's height. -->
  <xacro:macro name="suspension_spring" params="corner sprung_mass">
    <xacro:property name="stiffness" value="${sprung_mass * (2 * pi * suspension_frequency) ** 2}" />
    <gazebo reference="${corner}_suspension_joint">
      <springStiffness>${stiffness}</springStiffness>
      <springReference>${-sprung_mass * 9.80665 / stiffness}</springReference>
    </gazebo>
  </xacro:macro>
  <xacro:if value="${suspension}">
    <xacro:suspension_spring corner="front_left" sprung_mass="${front_corner_mass}" />
    <xacro:suspension_spring corner="front_right" sprung_mass="${front_corner_mass}" />
    <xacro:suspension_spring corner="rear_left" sprung_mass="${rear_corner_mass}" />
    <xacro:suspension_spring corner="rear_right" sprung_mass="${rear_corner_mass}" />
  </xacro:if>

  <!-- ============================== Tyres ============================== -->
  <!-- Grip and slip of the tyres on the ground.
         tyre:=dry|wet|gravel                a preset (default dry)
         tyre_mu_longitudinal:=, tyre_mu_lateral:=
                                             friction coefficients, driving/braking and sideways
         tyre_slip_longitudinal:=, tyre_slip_lateral:=
                                             slip compliance (Gazebo's WheelSlip): how much the
                                             tyre slips per unit of force/load; the slip angle
                                             [rad] is about lateral compliance x (lateral force /
                                             load), so 0.1 is ~3 deg at half the grip, a road tyre
       Each value overrides the preset's; from the launch file: xacro_args:="tyre_mu_lateral:=0.8". -->
  <xacro:arg name="tyre" default="dry" />
  <xacro:arg name="tyre_mu_longitudinal" default="" />
  <xacro:arg name="tyre_mu_lateral" default="" />
  <xacro:arg name="tyre_slip_longitudinal" default="" />
  <xacro:arg name="tyre_slip_lateral" default="" />
  <xacro:property name="tyre" value="$(arg tyre)" />
  <!-- Presets: [mu longitudinal, mu lateral, slip longitudinal, slip lateral]. An unknown name
       fails with "tyre_preset not defined". -->
  <xacro:if value="${tyre == 'dry'}">
    <xacro:property name="tyre_preset" value="${[1.1, 1.0, 0.05, 0.1]}" />
  </xacro:if>
  <xacro:if value="${tyre == 'wet'}">
    <xacro:property name="tyre_preset" value="${[0.7, 0.6, 0.08, 0.15]}" />
  </xacro:if>
  <xacro:if value="${tyre == 'gravel'}">
    <xacro:property name="tyre_preset" value="${[0.55, 0.5, 0.15, 0.3]}" />
  </xacro:if>
  <xacro:property name="tyre_mu_longitudinal" value="${float('$(arg tyre_mu_longitudinal)' or tyre_preset[0])}" />
  <xacro:property name="tyre_mu_lateral" value="${float('$(arg tyre_mu_lateral)' or tyre_preset[1])}" />
  <xacro:property name="tyre_slip_longitudinal" value="${float('$(arg tyre_slip_longitudinal)' or tyre_preset[2])}" />
  <xacro:property name="tyre_slip_lateral" value="${float('$(arg tyre_slip_lateral)' or tyre_preset[3])}" />

  <!-- fdir1 is the first friction direction in the wheel link's frame: its z axis, the axle.
       So mu1 is the sideways grip and mu2 the grip along the tyre, whichever way the wheel
       turns or steers (and WheelSlip's lateral slip goes with fdir1 too). -->
  <xacro:macro name="tyre" params="wheel">
    <gazebo reference="${wheel}">
      <mu1>${tyre_mu_lateral}</mu1>
      <mu2>${tyre_mu_longitudinal}</mu2>
      <fdir1>0 0 1</fdir1>
    </gazebo>
  </xacro:macro>
  <xacro:tyre wheel="front_left_wheel" />
  <xacro:tyre wheel="front_right_wheel" />
  <xacro:tyre wheel="rear_left_wheel" />
  <xacro:tyre wheel="rear_right_wheel" />

  <!-- Slip grows with the force on the tyre, like a real one, instead of full grip up to the
       friction limit. The load is the corner's weight at rest. -->
  <xacro:macro name="wheel_slip" params="wheel load">
    <wheel link_name="${wheel}">
      <slip_compliance_longitudinal>${tyre_slip_longitudinal}</slip_compliance_longitudinal>
      <slip_compliance_lateral>${tyre_slip_lateral}</slip_compliance_lateral>
      <wheel_normal_force>${load}</wheel_normal_force>
      <wheel_radius>${wheel_radius}</wheel_radius>
    </wheel>
  </xacro:macro>
  <xacro:property name="front_wheel_load" value="${front_corner_mass * 9.80665}" />
  <xacro:property name="rear_wheel_load" value="${rear_corner_mass * 9.80665}" />
  <gazebo>
    <plugin filename="gz-sim-wheel-slip-system" name="gz::sim::systems::WheelSlip">
      <xacro:wheel_slip wheel="front_left_wheel" load="${front_wheel_load}" />
      <xacro:wheel_slip wheel="front_right_wheel" load="${front_wheel_load}" />
      <xacro:wheel_slip wheel="rear_left_wheel" load="${rear_wheel_load}" />
      <xacro:wheel_slip wheel="rear_right_wheel" load="${rear_wheel_load}" />
    </plugin>
  </gazebo>

  <!-- ============================== Sensors ============================== -->
  <!-- Keep the rack as its own link, so the sensors hang off it -->
  <xacro:preserve_joint joint="roof_rack_joint" />

  <xacro:zed2_gazebo name="front_camera" namespace="${namespace}" />
  <xacro:imu_gazebo name="middle_imu" namespace="${namespace}" />
  <xacro:imu_gazebo name="front_imu" namespace="${namespace}" />
  <xacro:imu_gazebo name="back_imu" namespace="${namespace}" />
  <!-- One fix per antenna at 10 Hz -->
  <xacro:navsat_gazebo name="navsat_front_right" namespace="${namespace}" />
  <xacro:navsat_gazebo name="navsat_rear_left" namespace="${namespace}" />
  <xacro:vlp16_gazebo name="roof_lidar" namespace="${namespace}" />
  <xacro:lidar_2d_gazebo name="front_lidar" namespace="${namespace}" />

  <!-- ============================== Gazebo systems ============================== -->
  <!-- Ground truth pose of the whole model, used by the odometry_tf node -->
  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <topic>${namespace}/ground_truth/pose</topic>
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <update_frequency>50</update_frequency>
    </plugin>
  </gazebo>

  <!-- 50 Hz instead of every physics step, which only loaded robot_state_publisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- Rear-wheel drive (like the smart) and front steering from /<namespace>/actuators/cmd_vel -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <topic>${namespace}/actuators/cmd_vel</topic>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
      <kingpin_width>${front_track}</kingpin_width>
      <steering_limit>${steering_limit}</steering_limit>
      <!-- The steering joints follow the steering angle with this P gain: the default 1 is a
           1 s time constant, far slower than power steering, and made path following weave
           at speed. 8 is ~0.13 s. -->
      <steer_p_gain>8.0</steer_p_gain>
      <wheel_base>${wheel_base}</wheel_base>
      <wheel_separation>${rear_track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_velocity>${-max_reverse_speed}</min_velocity>
      <max_velocity>${max_speed}</max_velocity>
      <min_acceleration>${-max_deceleration}</min_acceleration>
      <max_acceleration>${max_acceleration}</max_acceleration>

      <odom_publish_frequency>10</odom_publish_frequency>
      <odom_topic>${namespace}/calculations/steering_odom</odom_topic>
      <tf_topic>${namespace}/tf/steering_odom</tf_topic>
      <!-- Wheel odometry in the odom frame (REP 105), ready for an EKF -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

</robot>
