<?xml version="1.0"?>

<sdf version="1.9">

  <world name="sonoma">
    <!-- Include the Sonoma Raceway environment -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sonoma Raceway</uri>
    </include>

    <!-- 2 ms physics step (default 1 ms): real-time factor ~0.55 -> ~0.87 with the
         sensors streaming; 4 ms gained almost nothing more. -->
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene settings (ambient + background) -->
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.678 0.847 0.902</background>
    </scene>

    <!-- Directional sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <!-- Real location of the Sonoma Raceway model's origin, found by fitting the
           model's track surface to the OpenStreetMap raceway ways (median error ~5 m,
           about half the track width). GPS (navsat) readings then line up with maps. -->
      <latitude_deg>38.1628083</latitude_deg>
      <longitude_deg>-122.4579944</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.83</heading_deg>
    </spherical_coordinates>

  </world>
</sdf>
